# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed; .env.example only documents what's needed and stays in git.

# ---------------------------------------------------------------------------
# Postgres (consumed directly by the `postgres` and `pgadmin` docker-compose
# services via env_file, as well as by DATABASE_URL below)
# ---------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mydb

# pgAdmin's own login (web UI at http://localhost:5050), unrelated to the
# Postgres superuser above.
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Datastores used by the app itself
# ---------------------------------------------------------------------------
# SQLAlchemy connection string. Must match POSTGRES_USER/PASSWORD/DB above.
# Special characters in the password (e.g. @) need to be percent-encoded here.
DATABASE_URL=postgresql://admin:change-me@localhost:5432/mydb
# Backs the login rate limiter (core/rate_limit.py). Falls back to this same
# local default if unset, so it's optional in dev.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Auth / JWT (core/auth.py)
# ---------------------------------------------------------------------------
# Signing key for JWTs. Generate a real one with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dev-only: relaxes the login cookies' Secure flag so they still work over
# plain http on localhost. Must be unset/false in production (HTTPS only).
DEBUG=true

# ---------------------------------------------------------------------------
# Cloudinary (core/cloudinary.py) - image/document uploads for horse listings
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---------------------------------------------------------------------------
# Resend (core/email.py) - transactional email for booking status changes
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@yourdomain.com
# Dev-only: redirects every outgoing email to this address (real recipient is kept
# in the subject as "[to: ...]"). Uncomment to route all mail to yourself during
# local testing, e.g. while on Resend's sandbox sender before a domain is verified.
# EMAIL_OVERRIDE_TO=you@example.com

# ---------------------------------------------------------------------------
# Stripe (core/stripe_client.py) - donation checkout + Connect payouts
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_key
# From `stripe listen` (local dev). Replace with the Dashboard endpoint's secret
# once deployed.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Deployed frontend's origin (email verification/reset links, Stripe checkout
# and Connect onboarding redirects). Defaults to the local dev server if unset
# -- set this explicitly to your real domain in production.
FRONTEND_URL=http://localhost:5173
